# Copy to .env and fill in credentials locally. Never commit .env.
DATABASE_BACKEND=supabase
# Supabase project URL and anon/public key (Project Settings -> API).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Paste the full URI from Project Settings -> Database -> Connection string.
# Use the session pooler URI; replace its password placeholder with your database password.
SUPABASE_DB_URL=

# Used only when DATABASE_BACKEND=sqlite (for local tests/development).
DATABASE_PATH=coordinator.db
TELEGRAM_BOT_TOKEN=

# disabled or openai_compatible. For an OpenAI-compatible API:
LLM_PROVIDER=disabled
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# Follow-ups cannot be sent more often than this per task.
FOLLOW_UP_COOLDOWN_HOURS=24
# Set above 0 to enable periodic reminder checks in the Telegram polling process.
REMINDER_INTERVAL_MINUTES=0
